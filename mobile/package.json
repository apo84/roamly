{
  "name": "mobile-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node --require ./scripts/polyfill-parseenv.cjs ./node_modules/expo/bin/cli start",
    "android": "node ./scripts/ensure-android-local-properties.cjs && node --require ./scripts/polyfill-parseenv.cjs ./node_modules/expo/bin/cli run:android",
    "ios": "node --require ./scripts/polyfill-parseenv.cjs ./node_modules/expo/bin/cli run:ios",
    "web": "node --require ./scripts/polyfill-parseenv.cjs ./node_modules/expo/bin/cli start --web"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.100.1",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.8",
    "expo-auth-session": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.18",
    "expo-font": "~55.0.4",
    "expo-image": "~55.0.6",
    "expo-linking": "~55.0.9",
    "expo-router": "~55.0.8",
    "expo-status-bar": "~55.0.4",
    "expo-web-browser": "~55.0.10",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.2",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "private": true
}
