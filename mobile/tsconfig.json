{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "customConditions": [
      "react-native-strict-api",
      "react-native"
    ]
  },
  "include": [
    "app/**/*.tsx",
    "contexts/**/*.tsx",
    "lib/**/*.ts",
    "components/**/*.tsx",
    "data/**/*.ts",
    "theme/**/*.ts",
    "utils/**/*.ts"
  ]
}
