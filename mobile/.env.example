# Copy to .env and fill in. Restart Expo after changes.

# Android native builds (Gradle). Optional if the SDK is at the default path:
#   macOS: ~/Library/Android/sdk
# If `npm run android` says SDK not found, set one of:
# ANDROID_SDK_ROOT=/path/to/Android/sdk
# ANDROID_HOME=/path/to/Android/sdk

# Supabase project (same as web; use anon key only — never service role on device)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Backend API base URL (no trailing slash). Not VITE_APP_URL and not exp:// — that is Metro.
# The EXPO_PUBLIC_API_URL= line must be the real URL (comments alone do nothing).
# - iOS simulator / web: http://localhost:4000
# - Android emulator: http://10.0.2.2:4000
# - Physical device on Wi‑Fi: http://YOUR_LAN_IP:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Android MapView (Google Maps). Enable "Maps SDK for Android" on the key in Google Cloud Console.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=your_android_maps_key
