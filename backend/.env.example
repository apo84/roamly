# Copy to .env — never commit real secrets.

# --- Required (existing backend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
APP_OAUTH_REDIRECT_URL=

# --- Optional: video columns (see migrations) ---
# SUPABASE_VIDEO_INCLUDE_COMMENT_COUNT=1
# SUPABASE_VIDEO_INCLUDE_VIEW_COUNT=1

# --- Geotag pipeline (see docs/backend/GEOTAG.md) ---
GEOTAG_ENABLED=1
GEOTAG_ASYNC=1
GEOTAG_ON_SAVE=0
#
# Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# GEMINI_TIMEOUT_MS=45000
# GEOTAG_MIN_CONFIDENCE_TO_WRITE=0.35
# MAP_PIN_MIN_CONFIDENCE=0.25
# GEOTAG_POLL_MS=5000

PORT=4000
